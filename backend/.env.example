# Configuración del Servidor
PORT=3000 # Puerto en el que correrá la aplicación

# Orígenes CORS permitidos (coma-separados). En producción obligatorio; no usar *.
CORS_ORIGIN=http://localhost:5173


# Configuración de la Base de Datos (PostgreSQL)
# Requerido por TypeORM CLI (data-source.ts) para migration:generate|run|revert
DB_HOST=localhost       # Host de la base de datos
DB_PORT=5432            # Puerto de PostgreSQL
DB_USERNAME=postgres    # Usuario de la base de datos
DB_PASSWORD=123456      # Contraseña del usuario (ajustar a tu Postgres local)
DB_DATABASE=mof_db      # Nombre de la base de datos MOF

# Base de datos legacy (dump umsa_db.sql restaurado) — ScriptETL
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=5432
LEGACY_DB_USERNAME=postgres
LEGACY_DB_PASSWORD=123456
LEGACY_DB_DATABASE=umsa_legacy

# Configuración de JWT (JSON Web Token)
# JWT_SECRET es obligatorio: no puede estar vacío ni ser el valor débil "secret".
# El valor de abajo es de ejemplo SOLO para desarrollo: con NODE_ENV=production
# el backend no arranca con él ni con un secreto de menos de 32 caracteres.
# Generar uno propio con: openssl rand -base64 48
JWT_SECRET=super_secret_key_random_string # Clave secreta para firmar los tokens
JWT_EXPIRES_IN=1d                          # Tiempo de expiración del token (ej: 1h, 1d, 7d)

# Rate limiting (por IP del cliente; trust proxy = 1 hop detrás de Apache)
# TRUST_PROXY: número de proxies delante de Nest (entero, nunca "true").
#   1 = Apache en el host es el único acceso público (default en producción).
#   0 = se entra directo a Nest (default en dev); si no, un X-Forwarded-For
#       falso eludiría el límite.
# El contador vive en memoria del proceso (válido para una sola instancia).
TRUST_PROXY=0
THROTTLE_TTL_MS=60000          # Ventana global (ms)
THROTTLE_LIMIT=60              # Límite global: resto del API
THROTTLE_AUTH_TTL_MS=60000     # Ventana auth (ms)
THROTTLE_AUTH_LIMIT=10         # Límite estricto: login / primer-acceso / cambiar-password

# Base URL del frontend embebida en el QR del PDF de unidad (sin slash final).
# En local: http://localhost:5173. En producción: la URL real del frontend (no localhost).
MOF_PDF_QR_BASE_URL=http://localhost:5173

# Migraciones (mismo flujo que MPP/backend):
#   npm run migration:generate -- src/migrations/NombreMigracion
#   npm run migration:run
#   npm run seed                 # organigrama ETL (sin dump legacy)
#   npm run seed -- --force      # recarga el snapshot
#   npm run migration:revert

# Propagación del organigrama hacia la Gaceta IA (opcional)
# Sin GACETA_URL no se envía nada: los cambios quedan anotados en
# auditoria_cambio y se entregan en cuanto se configure el destino.
GACETA_URL=http://localhost:8000        # base de la API de la Gaceta IA
GACETA_ADMIN_TOKEN=                     # mismo valor que GACETA_ADMIN_TOKEN alla
GACETA_TIMEOUT_MS=8000                  # corte por peticion
GACETA_MAX_INTENTOS=10                  # tras esto el evento se deja para la reconciliacion
