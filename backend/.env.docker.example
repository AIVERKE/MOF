# Configuracion del Servidor
PORT=3000

# Configuracion de la Base de Datos (PostgreSQL dentro de docker-compose)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=mof_db

# Configuracion de JWT (JSON Web Token)
# JWT_SECRET es obligatorio: no puede estar vacio ni ser el valor debil "secret"
JWT_SECRET=super_secret_key_random_string
JWT_EXPIRES_IN=1d

# Propagacion del organigrama hacia la Gaceta IA (opcional)
# En Docker, la Gaceta no esta en localhost del contenedor: usa el nombre del
# servicio si comparten red, o host.docker.internal si corre en la maquina.
GACETA_URL=
GACETA_ADMIN_TOKEN=
GACETA_TIMEOUT_MS=8000
GACETA_MAX_INTENTOS=10
