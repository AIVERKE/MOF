# Configuracion del Servidor
PORT=3000

# Origenes CORS permitidos (coma-separados). En produccion obligatorio; no usar *.
CORS_ORIGIN=http://localhost:5173


# Configuracion de la Base de Datos (PostgreSQL dentro de docker-compose)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=mof_db

# Configuracion de JWT (JSON Web Token)
# JWT_SECRET es obligatorio: no puede estar vacio ni ser el valor debil "secret"
JWT_SECRET=super_secret_key_random_string
JWT_EXPIRES_IN=1d

# Rate limiting (por IP del cliente; trust proxy = 1 hop detras de Apache)
# TRUST_PROXY=1 solo si Apache es el unico acceso publico (publicar el puerto
# como 127.0.0.1:3000:3000). Con "3000:3000" abierto, dejar 0.
TRUST_PROXY=0
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10

# Propagacion del organigrama hacia la Gaceta IA (opcional)
# En Docker, la Gaceta no esta en localhost del contenedor: usa el nombre del
# servicio si comparten red, o host.docker.internal si corre en la maquina.
GACETA_URL=
GACETA_ADMIN_TOKEN=
GACETA_TIMEOUT_MS=8000
GACETA_MAX_INTENTOS=10
